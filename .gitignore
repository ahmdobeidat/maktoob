# Runtime state — contains WhatsApp session identity keys, private media and
# transcripts. Anyone holding data/ can impersonate the linked account.
/data/
*.db
*.db-wal
*.db-shm

# Bake-off working files: real voice notes and hand-written ground truth.
# Third-party audio must never enter git.
/bakeoff/

# WER corpus: a recorded voice identifies the person who recorded it, so the
# audio stays out of git. The reference transcripts and the harness are
# committed, which is what makes the published number auditable. See docs/WER.md.
/testdata/wer/*
!/testdata/wer/reference.tsv

# Models (gigabytes, fetched by scripts/setup.sh)
/models/
*.bin

# Build artifacts
/maktoob
/vendor-build/
/dist/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Env / secrets
.env
.env.*
*.local
!.env.example
